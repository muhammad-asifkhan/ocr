# Environment Configuration for Government Document Verification System
# Copy this file to .env and fill in your actual values

# API Configuration
API_KEY=your-secure-api-key-change-in-production

# CORS Configuration (IMPORTANT: Set for production)
# Comma-separated list of allowed origins (e.g., "https://example.com,https://app.example.com")
# If not set, defaults to "*" (wildcard) for development only
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Optional: Override default settings
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=INFO